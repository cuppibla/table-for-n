# How this lab talks to Gemini: Vertex AI, on your own Google Cloud project.
# Nothing to paste, nothing to leak. In Cloud Shell you are already signed in,
# so this is all it takes:
#
#   gcloud auth application-default login     # not needed in Cloud Shell
#   gcloud config set project YOUR_PROJECT_ID  # ./setup_project.sh did this
#
# Leave the line below as-is and the lab picks up that project on its own.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id      # only if gcloud isn't already set
# GOOGLE_CLOUD_LOCATION=global              # the default; gemini-2.5-flash is served from global
# HOST_MODEL=gemini-2.5-flash                # the model the host (and the judge, the loop, the optimizer) runs on.
#                                            # The lab's numbers were measured on 2.5-flash; a project that cannot see
#                                            # it (404 "publisher model not found") can run on gemini-3-flash-preview —
#                                            # ./setup_codelab.sh writes that line for you when it has to.

# ── on a laptop without a project ────────────────────────────────────────────
# An AI Studio key runs the whole lab. Comment out the Vertex line and:
# GOOGLE_API_KEY=…                           # https://aistudio.google.com/apikey

# ── course IX · the receipt (needs the project) ─────────────────────────────
# The BigQuery dataset the host writes one row per event to, from this page
# and from Agent Engine alike. Create it once:  bq mk -d --location=US table_for_n
# The plugin makes the table and the v_eval_turn / v_eval_session views itself.
# BQ_ANALYTICS_DATASET=table_for_n
# BQ_ANALYTICS_LOCATION=US
# BQ_FLUSH=1                                 # 1 here (the row is there when you press 🧾); the deploy job sets 0 for the host it ships
# HARVEST_JUDGE=0                            # 1: refuel/harvest.py also runs a rubric judge over the rows the checker cannot read

# ── beyond the lab · refuel/ (needs the project) ────────────────────────────
# The resource name of the Agent Engine you deploy the shipped host to.
# HOST_ENGINE=projects/…/locations/us-central1/reasoningEngines/…
# DEPLOY_REGION=us-central1
# ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=true  # traces carry the messages — the platform judge reads them
