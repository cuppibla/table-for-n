# Table for N — copy to .env. One of the two paths:

# A · AI Studio key (laptop). Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# B · Vertex AI (Cloud Shell / a Google Cloud project). Leave the key blank and set:
# GOOGLE_GENAI_USE_VERTEXAI=True
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# Course VI only — filled in by the page's ☁ deploy button, or paste yours:
# HOST_ENGINE=projects/…/locations/us-central1/reasoningEngines/…
# ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=true
